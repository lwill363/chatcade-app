{
  "name": "chatcade-backend",
  "packageManager": "yarn@4.11.0",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev:auth": "tsx watch src/features/auth/auth-server.ts",
    "dev:channels": "tsx watch src/features/channels/channels-server.ts",
    "dev:friends": "tsx watch src/features/friends/friends-server.ts",
    "dev:games": "tsx watch src/features/games/games-server.ts",
    "dev:messages": "tsx watch src/features/messages/messages-server.ts",
    "dev:users": "tsx watch src/features/users/users-server.ts",
    "build": "tsup src --out-dir dist --format cjs --dts false",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1152.0",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
